{
  "name": "zpsr0010",
  "version": "0.0.1",
  "description": "An SAP Fiori application.",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {},
  "devDependencies": {
    "@ui5/cli": "^3.0.0",
    "@sap/ux-ui5-tooling": "1",
    "@sap-ux/ui5-middleware-fe-mockserver": "2",
    "rimraf": "^3.0.2",
    "ui5-task-flatten-library": "0.2.5",
    "@prettier/plugin-xml": "^3.4.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3"
  },
  "scripts": {
    "start": "fiori run --open \"test/flpSandbox.html?sap-language=ja&sap-client=340&sap-ui-xx-viewCache=false#zpsr0010-display\"",
    "start-local": "fiori run --config ./ui5-local.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#zpsr0010-display\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "format:def": "prettier --write \"webapp/**/*.{js,jsx,css}\"",
    "format:xml": "prettier --plugin=@prettier/plugin-xml --write \"webapp/**/*.xml\"",
    "format": "run-s format:def format:xml",
    "deploy": "npm run build && fiori deploy --config ui5-deploy.yaml && rimraf archive.zip",
    "deploy-config": "fiori add deploy-config",
    "start-noflp": "fiori run --open \"index.html?sap-ui-xx-viewCache=false\"",
    "start-mock": "fiori run --config ./ui5-mock.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#zpsr0010-display\"",
    "int-test": "fiori run --config ./ui5-mock.yaml --open 'test/integration/opaTests.qunit.html'",
    "start-variants-management": "fiori run --open \"preview.html?sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#preview-app\"",
    "unit-test": "fiori run --config ./ui5-mock.yaml --open 'test/unit/unitTests.qunit.html'",
    "undeploy": "npm run build && fiori undeploy --config ui5-deploy.yaml",
    "deploy-test": "npm run build && fiori deploy --config ui5-deploy.yaml --testMode true"
  },
  "sapuxLayer": "CUSTOMER_BASE"
}
