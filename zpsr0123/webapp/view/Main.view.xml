					type="{screen>/MessageButtonType}"
					text="{screen>/MessageCount}"
					press="onPressMessageButton"
					ariaHasPopup="Dialog"
					visible="{screen>/HaveMessage}"
				>
                    <dependents>
                        <MessagePopover id="messageArea" items="{screen>/Messages}">
                            <MessageItem
								id="_IDGenMessageItem1"
								type="{screen>type}"
								title="{screen>title}"
								description="{screen>description}"
								subtitle="{screen>subtitle}"
								counter="{screen>counter}"
							/>
                        </MessagePopover>
                    </dependents>
                </Button>
				<ToolbarSpacer id="_IDGenToolbarSpacer" />
				<Button text="{i18n>btnRegister}" id="SaveButton" type="Emphasized" press="onPressSaveButton" />
				<Button
					text="{i18n>btnRegisterRemarksOnly}"
					id="SaveButtonRemarksOnly"
					type="Emphasized"
